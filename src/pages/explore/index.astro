---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import FeatureNotice from '../../components/ui/FeatureNotice.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

// Generic categories only — real places will come from the database.
const categories = ['Restaurants', 'Cafés', 'Bars', 'Activities', 'Outdoors', 'Culture'];
---

<AppLayout title="Explore" description="Discover restaurants and activities recommended by your circle.">
  <PageHeader
    eyebrow="Discover"
    title="Explore"
    description="Restaurants and activities recommended by people you trust."
  >
    <Button slot="actions" disabled>Suggest a place</Button>
  </PageHeader>

  <section aria-labelledby="categories-heading" class="mb-12">
    <h2 id="categories-heading" class="mb-4 text-sm font-semibold tracking-widest text-ink-muted uppercase">
      Categories
    </h2>
    <ul class="flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <li class="rounded-full border border-line bg-surface px-4 py-2 text-sm text-ink">{category}</li>
        ))
      }
    </ul>
  </section>

  <FeatureNotice class="mb-8" feature="The place directory" requires="the Supabase database">
    Search, filters, and recommendations will appear here.
  </FeatureNotice>

  <EmptyState
    title="No places yet"
    description="Once members start adding recommendations, restaurants and activities will show up here."
  />
</AppLayout>
