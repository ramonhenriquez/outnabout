---
import AppLayout from '../../layouts/AppLayout.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import FeatureNotice from '../../components/ui/FeatureNotice.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

const steps = [
  { title: 'Pick a place', description: 'Choose from Explore or one of your collections.' },
  { title: 'Propose a time', description: 'Suggest a date and let friends weigh in.' },
  { title: 'Invite friends', description: 'Outings stay private to the people you invite.' },
];
---

<AppLayout title="Outings" description="Plan private outings with your friends.">
  <PageHeader
    eyebrow="Gather"
    title="Outings"
    description="Plan nights out together — where, when, and who is coming."
  >
    <Button slot="actions" disabled>Plan an outing</Button>
  </PageHeader>

  <section aria-labelledby="how-heading" class="mb-12">
    <h2 id="how-heading" class="mb-6 text-2xl font-semibold text-ink">How planning will work</h2>
    <ol class="grid gap-4 sm:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="rounded-2xl border border-line bg-surface p-5">
            <span class="font-serif text-3xl text-accent" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="mt-2 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-ink-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <FeatureNotice class="mb-8" feature="Outing planning" requires="Supabase authentication and database" />

  <EmptyState title="No upcoming outings" description="Outings you create or are invited to will appear here.">
    <svg slot="icon" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
      <path d="M3 10h18M8 3v4M16 3v4"></path>
    </svg>
  </EmptyState>
</AppLayout>
