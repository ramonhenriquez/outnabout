---
interface Props {
  title: string;
  description?: string;
  /** Heading level for the title, to keep the document outline correct. */
  headingLevel?: 2 | 3;
  class?: string;
}

const { title, description, headingLevel = 2, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<section
  class:list={[
    'flex flex-col items-center rounded-2xl border border-dashed border-line bg-surface px-6 py-14 text-center',
    className,
  ]}
>
  <div class="mb-5 flex size-12 items-center justify-center rounded-full bg-accent-soft text-accent" aria-hidden="true">
    <slot name="icon">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"></path>
        <circle cx="12" cy="9.5" r="2.5"></circle>
      </svg>
    </slot>
  </div>
  <Heading class="text-2xl font-semibold text-ink">{title}</Heading>
  {description && <p class="mt-3 max-w-md leading-relaxed text-ink-muted">{description}</p>}
  {
    Astro.slots.has('default') && (
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <slot />
      </div>
    )
  }
</section>
