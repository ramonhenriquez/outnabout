---
/**
 * Stand-in for photography until real images are available. Decorative only,
 * so it is hidden from assistive technology.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Photo placeholder', class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    'relative flex w-full items-end overflow-hidden bg-gradient-to-br from-accent-soft via-surface-muted to-line',
    className,
  ]}
>
  <svg class="absolute inset-0 m-auto size-12 text-ink-muted/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <circle cx="9" cy="10" r="1.75"></circle>
    <path d="M21 16l-5-5-8 8"></path>
  </svg>
  <span class="relative m-3 rounded-full bg-canvas/80 px-2.5 py-1 text-[11px] font-medium tracking-wide text-ink-muted uppercase">
    {label}
  </span>
</div>
