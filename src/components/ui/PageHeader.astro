---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
}

const { title, eyebrow, description } = Astro.props;
---

<header class="mb-10 flex flex-col gap-6 border-b border-line pb-8 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="mb-3 text-xs font-semibold tracking-widest text-accent uppercase">{eyebrow}</p>}
    <h1 class="text-4xl font-semibold text-ink sm:text-5xl">{title}</h1>
    {description && <p class="mt-4 text-lg leading-relaxed text-ink-muted">{description}</p>}
  </div>
  {
    Astro.slots.has('actions') && (
      <div class="flex shrink-0 flex-wrap gap-3">
        <slot name="actions" />
      </div>
    )
  }
</header>
